* Part of patchset to build chromium on NetBSD
* Based on OpenBSD's chromium patches, and
  pkgsrc's qt5-qtwebengine patches

--- build/rust/rust_bindgen_generator.gni.orig	2026-11-02 23:22:33.000000000 +0000
+++ build/rust/rust_bindgen_generator.gni
@@ -7,12 +7,12 @@ import("//build/config/rust.gni")
 import("//build/rust/gni_impl/libclang_args.gni")
 import("//build/rust/rust_static_library.gni")
 
-_bindgen_path = "${rust_bindgen_root}/bin/bindgen"
+_bindgen_path = "@PREFIX@/bin/bindgen"
 if (host_os == "win") {
   _bindgen_path = "${_bindgen_path}.exe"
 }
 
-_rustfmt_path = "${rust_bindgen_root}/bin/rustfmt"
+_rustfmt_path = "@PREFIX@/bin/rustfmt"
 if (!use_chromium_rust_toolchain &&
     (host_cpu == "ppc64" || host_cpu == "s390x")) {
   _rustfmt_path = rust_sysroot_absolute + "/bin/rustfmt"
@@ -22,7 +22,7 @@ if (!use_chromium_rust_toolchain &&
 
 # On Windows, the libclang.dll is beside the bindgen.exe, otherwise it is in
 # ../lib.
-_libclang_path = rust_bindgen_root
+_libclang_path = "@PREFIX@"
 if (!use_chromium_rust_toolchain &&
     (host_cpu == "ppc64" || host_cpu == "s390x")) {
   _libclang_path = rust_sysroot_absolute + "/lib64"
