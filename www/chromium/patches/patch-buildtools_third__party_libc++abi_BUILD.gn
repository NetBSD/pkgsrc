$NetBSD: patch-buildtools_third__party_libc++abi_BUILD.gn,v 1.6 2026/10/13 13:16:31 kikadf Exp $

* Part of patchset to build chromium on NetBSD
* Based on OpenBSD's chromium patches, and
  pkgsrc's qt5-qtwebengine patches

--- buildtools/third_party/libc++abi/BUILD.gn.orig	2026-10-06 00:06:58.000000000 +0000
+++ buildtools/third_party/libc++abi/BUILD.gn
@@ -59,7 +59,7 @@ target(libcxxabi_target_type, "libc++abi
 
   defines = [ "LIBCXXABI_SILENT_TERMINATE" ]
 
-  if (is_linux || is_android) {
+  if ((is_linux || is_android) && !is_freebsd && !is_netbsd) {
     defines += [ "_LIBCXXABI_USE_FUTEX" ]
   }
 
