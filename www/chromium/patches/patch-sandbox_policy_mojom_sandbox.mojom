$NetBSD: patch-sandbox_policy_mojom_sandbox.mojom,v 1.18 2026/04/21 15:21:19 kikadf Exp $

* Part of patchset to build chromium on NetBSD
* Based on OpenBSD's chromium patches, and
  pkgsrc's qt5-qtwebengine patches

--- sandbox/policy/mojom/sandbox.mojom.orig	2026-04-14 23:31:37.000000000 +0200
+++ sandbox/policy/mojom/sandbox.mojom
@@ -68,6 +68,15 @@ enum Sandbox {
   // Minimally privileged sandbox on Fuchsia.
   [EnableIf=is_fuchsia] kVideoCapture,
 
+  [EnableIf=is_openbsd]
+  kVideoCapture,
+
+  [EnableIf=is_netbsd]
+  kVideoCapture,
+
+  [EnableIf=is_freebsd]
+  kVideoCapture,
+
   // Allows access to file contents and Windows APIs for parsing icons from PE
   // files.
   [EnableIf=is_win] kIconReader,
