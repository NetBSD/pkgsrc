$NetBSD: patch-build_rust_std_BUILD.gn,v 1.33 2026/11/19 19:45:52 kikadf Exp $

* Part of patchset to build chromium on NetBSD
* Based on OpenBSD's chromium patches, and
  pkgsrc's qt5-qtwebengine patches

--- build/rust/std/BUILD.gn.orig	2026-11-11 21:01:38.000000000 +0000
+++ build/rust/std/BUILD.gn
@@ -46,11 +46,15 @@ if (toolchain_has_rust) {
   if (!is_win) {
     # These are no longer present in the Windows toolchain.
     stdlib_files += [
+      "addr2line",
+      "adler2",
+      "gimli",
       "libc",
 
       # TODO(crbug.com/435700430): Remove `memchr` and `object` once
       # https://github.com/rust-lang/rust/issues/151776 is resolved.
       "memchr",
+      "miniz_oxide",
       "object",
     ]
   }
@@ -72,7 +76,6 @@ if (toolchain_has_rust) {
   # don't need to pass to the C++ linker because they're used for specialized
   # purposes.
   skip_stdlib_files = [
-    "profiler_builtins",
     "rustc_std_workspace_alloc",
     "rustc_std_workspace_core",
   ]
