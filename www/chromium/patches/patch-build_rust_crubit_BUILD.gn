$NetBSD: patch-build_rust_crubit_BUILD.gn,v 1.1 2026/11/08 15:38:52 kikadf Exp $

* Part of patchset to build chromium on NetBSD
* Based on OpenBSD's chromium patches, and
  pkgsrc's qt5-qtwebengine patches

--- build/rust/crubit/BUILD.gn.orig	2026-11-02 23:22:33.000000000 +0000
+++ build/rust/crubit/BUILD.gn
@@ -10,9 +10,7 @@ group("crubit") {
   public_deps = [
     "$crubit_src_dir/support:support_cpp",
     "$crubit_src_dir/support/rs_std:rs_std_cpp",
-    "//build/rust/std/rules:alloc_bindings",
-    "//build/rust/std/rules:core_bindings",
-    "//build/rust/std/rules:std_bindings",
+    "//build/rust/std:std_bindings",
   ]
 }
 
@@ -22,7 +20,7 @@ config("public_config") {
   # `include_dirs` below help ensure that Chromium can use the same
   # `#include` paths as other Crubit clients like google3 - e.g.
   # `#include "third_party/crubit/support/rs_std/slice_ref.h"`.
-  include_dirs = [ "//third_party/rust-toolchain/lib" ]
+  include_dirs = [ "${rust_crubit_root}/lib" ]
 }
 
