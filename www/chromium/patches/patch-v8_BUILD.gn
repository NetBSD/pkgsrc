 # run_mksnapshot_<name>. If <name> is "default", no file suffixes will be used.
@@ -2998,7 +3026,11 @@ template("run_mksnapshot") {
   }
 
   action("run_mksnapshot_" + name) {
-    deps = [ ":mksnapshot($v8_snapshot_toolchain)" ]
