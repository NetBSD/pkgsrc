  pkgsrc's qt5-qtwebengine patches

--- src/3rdparty/chromium/third_party/tflite/features.gni.orig	2026-03-16 11:40:07.000000000 +0000
+++ src/3rdparty/chromium/third_party/tflite/features.gni
@@ -8,7 +8,7 @@ import("//services/on_device_model/on_de
 
 declare_args() {
   # This enables building TFLite with XNNPACK.
-  build_tflite_with_xnnpack = current_cpu != "arm" && !is_fuchsia
