$NetBSD: patch-src_3rdparty_chromium_sandbox_policy_mojom_sandbox.mojom,v 1.2 2026/04/30 06:39:42 adam Exp $

* Part of patchset to build chromium on NetBSD
* Based on OpenBSD's chromium patches, and
  pkgsrc's qt5-qtwebengine patches

--- src/3rdparty/chromium/sandbox/policy/mojom/sandbox.mojom.orig	2026-03-16 11:40:07.000000000 +0000
+++ src/3rdparty/chromium/sandbox/policy/mojom/sandbox.mojom
@@ -71,6 +71,15 @@ enum Sandbox {
   // Minimally privileged sandbox on Fuchsia.
   [EnableIf=is_fuchsia] kVideoCapture,
 
+  [EnableIf=is_openbsd]
+  kVideoCapture,
+
+  [EnableIf=is_netbsd]
+  kVideoCapture,
+
+  [EnableIf=is_freebsd]
+  kVideoCapture,
+
   // Allows access to file contents and Windows APIs for parsing icons from PE
   // files.
   [EnableIf=is_win] kIconReader,
