InfluxDB is an open-source time series database.
The InfluxDB data source plugin lets Grafana query, visualize, and alert
on metrics stored in InfluxDB, using InfluxQL, Flux or SQL.

To install this plugin, do
# ln -s /usr/pkg/share/grafana/plugins/influxdb /var/lib/grafana/plugins

Ensure the following settings are present in grafana's configuration file:
[plugins]
preinstall_disabled = true
preinstall_auto_update = false
allow_loading_unsigned_plugins = influxdb

[plugin.influxdb]
as_external = true
