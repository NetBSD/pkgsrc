$NetBSD: patch-Makefile.in,v 1.4 2025/11/06 16:13:25 adam Exp $

Fix linking against Tcl.

--- Makefile.in.orig	2025-11-06 16:02:30.763164306 +0000
+++ Makefile.in
@@ -227,7 +227,7 @@ CC.tcl = \
 #
 CC.dll = \
   $(CC.tcl) $(tx.src) $(LDFLAGS.shlib) \
-    $(tx.LDFLAGS) $(LDFLAGS.configure) $(LDFLAGS) $(TCL_STUB_LIB_SPEC)
+    $(tx.LDFLAGS) $(LDFLAGS.configure) $(LDFLAGS) $(TCL_LIB_SPEC)
 
 @if TEAISH_ENABLE_DLL
 #
