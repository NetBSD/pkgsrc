$NetBSD: patch-mixed_makefile,v 1.1 2026/09/23 20:31:34 rhialto Exp $

Use $(LDFLAGS).

--- mixed/makefile.orig	2026-09-23 16:37:24.030205473 +0000
+++ mixed/makefile
@@ -31,10 +31,10 @@ all:	macsave macstream
 	touch all
 
 macsave:	$(OBJS1) $(XOBJS1)
-	$(CC) $(CFLAGS) -o macsave $(OBJS1) $(XOBJS1)
+	$(CC) $(CFLAGS) $(LDFLAGS) -o macsave $(OBJS1) $(XOBJS1)
 
 macstream:	$(OBJS2) $(XOBJS2)
-	$(CC) $(CFLAGS) -o macstream $(OBJS2) $(XOBJS2)
+	$(CC) $(CFLAGS) $(LDFLAGS) -o macstream $(OBJS2) $(XOBJS2)
 
 $(TNAME).o:	$(TNAME).c
 	(cd ../util; make CC=$(CC) CF="$(CF)" )
