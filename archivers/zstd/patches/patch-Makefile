Enable the "install" target on all OS.

--- Makefile.orig	2026-11-24 09:17:15.296770133 +0000
+++ Makefile
@@ -150,7 +150,6 @@ include $(LIBZSTD_MK_DIR)/install_oses.mk # UNAME, INS
 #------------------------------------------------------------------------------
 # make install is validated only for Linux, macOS, Hurd and some BSD targets
 #------------------------------------------------------------------------------
-ifneq (,$(filter $(INSTALL_OS_LIST),$(UNAME)))
 
 HOST_OS = POSIX
 
@@ -385,7 +384,6 @@ clang38install:
 clang38install:
 	APT_PACKAGES="clang-3.8" $(MAKE) apt-install
 
-endif
 
 
 ifneq (,$(filter MSYS%,$(shell sh -c 'MSYSTEM="MSYS" uname') ))
