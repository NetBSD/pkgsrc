$NetBSD: patch-configure,v 1.2 2026/11/15 16:06:08 vins Exp $

* Standardise configure options to avoid PLIST inconsistencies.

--- configure.orig	2026-10-15 10:05:00.000000000 +0000
+++ configure
@@ -71,7 +71,7 @@ case `uname` in
 		alsa=yes
 		libbsd=yes
 		ldadd="-lrt -lm"
-		user=sndiod
+		user=_sndio
 		so_link="libsndio.so libsndio.so.\${MAJ}"
 		so_ldflags="-Wl,-soname=libsndio.so.\${MAJ}"
 		defs='-D_GNU_SOURCE -DHAVE_SOCK_CLOEXEC'
@@ -100,6 +100,8 @@ case `uname` in
 		rmidi=yes
 		user=_sndio
 		so_link="libsndio.so"
+		so_ldflags="-Wl,-soname=libsndio.so.\${MAJ}"
+		so_link="libsndio.so libsndio.so.\${MAJ}"
 		defs='-D_OPENBSD_SOURCE -DHAVE_ISSETUGID -DHAVE_SOCK_CLOEXEC'
 		;;
 	OpenBSD)
