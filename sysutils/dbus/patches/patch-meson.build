$NetBSD: patch-meson.build,v 1.5 2026/11/21 11:14:34 nros Exp $

* The real identifier for Solaris/Illumos is "sunos" not "solaris"
* The space before the -D_XOPEN_SOURCE=500 causes the compile test
  for it to fail somehow, causing the argument to not get added to
  the compile line

--- meson.build.orig	2026-11-12 16:15:25.000000000 +0000
+++ meson.build
@@ -171,14 +171,14 @@ compile_args = [
 # See https://gitlab.freedesktop.org/dbus/dbus/-/issues/4
 compile_args += ['-fno-strict-aliasing']
 
-if host_os.contains('solaris')
+if host_os.contains('sunos')
     compile_args += [
         # Solaris' C library apparently needs these runes to be threadsafe...
         '-D_POSIX_PTHREAD_SEMANTICS',
         # ... this opt-in to get sockaddr_in6 and sockaddr_storage...
         '-D__EXTENSIONS__',
         # ... and this opt-in to get file descriptor passing support
-        ' -D_XOPEN_SOURCE=500',
+        '-D_XOPEN_SOURCE=500',
     ]
 endif
 
@@ -548,8 +548,8 @@ endif
 have_console_owner_file = false
 console_owner_file = get_option('solaris_console_owner_file')
 if console_owner_file != ''
-  if not host_os.contains('solaris')
-    error('solaris_console_owner_file is only supported on Solaris)')
+  if not host_os.contains('sunos')
+    error('solaris_console_owner_file is only supported on Solaris/Illumos)')
   endif
   have_console_owner_file = true
   if console_owner_file == 'auto'
@@ -1395,7 +1395,7 @@ summary_dict += {
     'Tests socket dir':         test_socket_dir,
 }
 
-if host_os.contains('solaris')
+if host_os.contains('sunos')
   summary_dict += {
       'Console owner file': console_owner_file,
   }
