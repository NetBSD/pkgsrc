Support sed -i on more OS.

--- tests/sed-inplace.orig	2024-12-04 15:21:18.719762588 +0000
+++ tests/sed-inplace
@@ -1,6 +1,6 @@
 #!/usr/bin/env bash
 
-if [[ "$(uname -s)" =~ (Linux|CYGWIN_NT-) ]]; then
+if [[ "$(uname -s)" =~ (Linux|CYGWIN_NT-|BSD|SunOS) ]]; then
 	sed -i "$1" "$2"
 else
 	sed -i '' "$1" "$2"
