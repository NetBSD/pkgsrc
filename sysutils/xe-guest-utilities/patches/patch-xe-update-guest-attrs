+eval $(/sbin/ifconfig -a | \
+	awk '{
+		if ($0~"^[a-z][a-z0-9]*[0-9]:") {
+			if ($0~"^xennet[0-9]+:") {
+				current = $1
+				sub(":.*", "", current)
+				sub("xennet", "eth", current)
+				iflist = iflist " " current
+				ifs[current] = ""
+			} else {
+				current =""
+			}
+		}
+		if (($1 == "inet" || $1 == "inet6") && current != "") {
+			if ($2 == "alias") ip = $3
+			else ip = $2
