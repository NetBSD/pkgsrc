+			sub("/.*", "", ip)
+			if (ifs[current] != "") ifs[current] = ifs[current] ", " ip
+			else ifs[current] = ip
+		}
+	}
+	END {
+		sub("^ ", "", iflist)
+		printf "ifs=%c%s%c\n", 39, iflist, 39
+		for (i in ifs)
+			printf "inet_%s=%c%s%c\n", i, 39, ifs[i], 39
+	}')
 
