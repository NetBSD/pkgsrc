+				LibWinD = $(X11BASE)/lib ;
+			} else if [ GLOB $(PREFIX)/lib : libX11.so libX11.a ] {
+				LibWinD = $(PREFIX)/lib ;
+			} else if [ GLOB /usr/X11R6/lib : libX11.so libX11.a ] {
 				LibWinD = /usr/X11R6/lib ;
 			} else if [ GLOB /usr/lib/x86_64-linux-gnu : libX11.so libX11.a ] {
