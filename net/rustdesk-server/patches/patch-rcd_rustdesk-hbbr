+: ${rustdesk_hbbr_user:=@RUSTDESK_USER@}
+: ${rustdesk_hbbr_group:=@RUSTDESK_GROUP@}
 
-pidfile=/var/run/rustdesk_hbbr.pid
-command=/usr/sbin/daemon
-procname=/usr/local/sbin/hbbr
