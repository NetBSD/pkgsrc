$NetBSD: patch-Makefile.in,v 1.10 2025/04/20 19:15:42 wiz Exp $

Use askpass provided by pkgsrc.

Removed install-sysconf as we handle that phase through post-install

--- Makefile.in.orig	2025-04-09 07:02:43.000000000 +0000
+++ Makefile.in
@@ -20,7 +20,7 @@ abs_top_builddir=@abs_top_builddir@
 
 VPATH=@srcdir@
 SSH_PROGRAM=@bindir@/ssh
-ASKPASS_PROGRAM=$(libexecdir)/ssh-askpass
+#ASKPASS_PROGRAM=$(libexecdir)/ssh-askpass
 SFTP_SERVER=$(libexecdir)/sftp-server
 SSH_KEYSIGN=$(libexecdir)/ssh-keysign
 SSHD_SESSION=$(libexecdir)/sshd-session
@@ -421,7 +421,7 @@ distprep: catman-do depend-check
 	-rm -rf autom4te.cache .depend.bak
 
 install: $(CONFIGFILES) $(MANPAGES) $(TARGETS) install-files install-sysconf host-key check-config
-install-nokeys: $(CONFIGFILES) $(MANPAGES) $(TARGETS) install-files install-sysconf
+install-nokeys: $(CONFIGFILES) $(MANPAGES) $(TARGETS) install-files
 install-nosysconf: $(CONFIGFILES) $(MANPAGES) $(TARGETS) install-files
 
 check-config:
