$NetBSD: patch-samples_Makefile.in,v 1.2 2026/09/22 12:21:46 wiz Exp $

Install config into examples directory.
Let pkgsrc infrastructure create directory.

--- samples/Makefile.in.orig	2018-07-01 15:39:24.000000000 +0000
+++ samples/Makefile.in
@@ -2,7 +2,7 @@ prefix=@prefix@
 
 srcdir=@srcdir@
 prefix=@prefix@
-sysconfdir=@sysconfdir@
+sysconfdir=${DESTDIR}${PREFIX}/share/examples/racoon2
 datarootdir=@datarootdir@  
 INSTALL =@INSTALL@ @INSTALL_OPTS@
 INSTALL_PROGRAM=@INSTALL_PROGRAM@
@@ -13,7 +13,6 @@ install: all install-startup-@startup_scripts@ install
 all:
 
 install: all install-startup-@startup_scripts@ install-samples install-hook
-	$(INSTALL) -d -o 0 -g 0 -m 700 $(DESTDIR)/var/run/racoon2
 
 install-samples:
 	$(INSTALL) -d $(sysconfdir)
