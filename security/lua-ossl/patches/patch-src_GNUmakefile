 uninstall5.3: liblua5.3-openssl-uninstall
 uninstall5.4: liblua5.4-openssl-uninstall
+uninstall5.5: liblua5.5-openssl-uninstall
 uninstall: $(foreach API,$(strip $(LUA_APIS)),uninstall$(API))
 
 endif
