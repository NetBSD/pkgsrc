 ifneq "$(filter $(abspath $(d)/..)/%, $(abspath $(firstword $(MAKEFILE_LIST))))" ""
-.SECONDARY: all all5.1 all5.2 all5.3 all5.4
+.SECONDARY: all all5.1 all5.2 all5.3 all5.4 all5.5
 
