$NetBSD: patch-meson.build,v 1.1 2026/11/03 14:47:35 riastradh Exp $

Allow pkgsrc to override OpenSSL module dir in case pkg-config doesn't
provide it.

--- meson.build.orig	2026-09-22 14:45:27.000000000 +0000
+++ meson.build
@@ -49,7 +49,10 @@ libcrypto = dependency('libcrypto', vers
 if not libcrypto.found()
   libcrypto = dependency('libcrypto3', version: '>= 3.0.7', required: true)
 endif
+provider_path = get_option('modules_dir')
+if provider_path == ''
 provider_path = libcrypto.get_variable(pkgconfig: 'modulesdir')
+endif
 libssl = dependency('libssl', version: '>= 3.0.7', required: false)
 if not libssl.found()
   libssl = dependency('libssl3', version: '>= 3.0.7', required: true, method: 'pkg-config')
