$NetBSD: patch-lang_qt_src_Makefile.in,v 1.5 2025/12/21 15:31:53 markd Exp $

Use installed libraries
remove "-no-undefined" flag as it stops shared library being built.

--- lang/qt/src/Makefile.in.orig	2025-05-19 14:32:38.000000000 +0000
+++ lang/qt/src/Makefile.in
@@ -172,9 +172,7 @@ am__installdirs = "$(DESTDIR)$(libdir)" 
 	"$(DESTDIR)$(qgpgme5includedir)" \
 	"$(DESTDIR)$(qgpgme6includedir)"
 LTLIBRARIES = $(lib_LTLIBRARIES)
-@WANT_QT5_TRUE@libqgpgme_la_DEPENDENCIES =  \
-@WANT_QT5_TRUE@	../../cpp/src/libgpgmepp.la \
-@WANT_QT5_TRUE@	../../../src/libgpgme.la
+@WANT_QT5_TRUE@libqgpgme_la_DEPENDENCIES = 
 am__libqgpgme_la_SOURCES_DIST = cleaner.cpp dataprovider.cpp debug.cpp \
 	decryptverifyarchivejob.cpp decryptverifyjob.cpp \
 	encryptarchivejob.cpp filelistdataprovider.cpp job.cpp \
@@ -314,9 +312,7 @@ libqgpgme_la_LINK = $(LIBTOOL) $(AM_V_lt
 	$(LIBTOOLFLAGS) --mode=link $(CXXLD) $(AM_CXXFLAGS) \
 	$(CXXFLAGS) $(libqgpgme_la_LDFLAGS) $(LDFLAGS) -o $@
 @WANT_QT5_TRUE@am_libqgpgme_la_rpath = -rpath $(libdir)
-@WANT_QT6_TRUE@libqgpgmeqt6_la_DEPENDENCIES =  \
-@WANT_QT6_TRUE@	../../cpp/src/libgpgmepp.la \
-@WANT_QT6_TRUE@	../../../src/libgpgme.la
+@WANT_QT6_TRUE@libqgpgmeqt6_la_DEPENDENCIES = 
 am__libqgpgmeqt6_la_SOURCES_DIST = cleaner.cpp dataprovider.cpp \
 	debug.cpp decryptverifyarchivejob.cpp decryptverifyjob.cpp \
 	encryptarchivejob.cpp filelistdataprovider.cpp job.cpp \
@@ -1259,10 +1255,10 @@ qgpgme_moc_sources = \
 
 @WANT_QT5_TRUE@libqgpgme_la_SOURCES = $(qgpgme_sources) $(qgpgme_headers) $(private_qgpgme_headers)
 @WANT_QT5_TRUE@nodist_libqgpgme_la_SOURCES = $(qgpgme_moc5_sources) $(qgpgme_moc5_forward_headers)
-@WANT_QT5_TRUE@libqgpgme_la_LIBADD = ../../cpp/src/libgpgmepp.la ../../../src/libgpgme.la \
+@WANT_QT5_TRUE@libqgpgme_la_LIBADD = -lgpgmepp -lgpgme \
 @WANT_QT5_TRUE@                      @LIBASSUAN_LIBS@ @GPG_ERROR_LIBS@ @GPGME_QT5_LIBS@
 
-@WANT_QT5_TRUE@libqgpgme_la_LDFLAGS = -no-undefined -version-info \
+@WANT_QT5_TRUE@libqgpgme_la_LDFLAGS = -version-info \
 @WANT_QT5_TRUE@                       @LIBQGPGME_LT_CURRENT@:@LIBQGPGME_LT_REVISION@:@LIBQGPGME_LT_AGE@
 
 @WANT_QT6_TRUE@libqgpgmeqt6_la_CPPFLAGS = -I./moc6 -I$(top_builddir)/lang/cpp/src -I$(top_builddir)/src \
@@ -1272,10 +1268,10 @@ qgpgme_moc_sources = \
 
 @WANT_QT6_TRUE@libqgpgmeqt6_la_SOURCES = $(qgpgme_sources) $(qgpgme_headers) $(private_qgpgme_headers)
 @WANT_QT6_TRUE@nodist_libqgpgmeqt6_la_SOURCES = $(qgpgme_moc6_sources) $(qgpgme_moc6_forward_headers)
-@WANT_QT6_TRUE@libqgpgmeqt6_la_LIBADD = ../../cpp/src/libgpgmepp.la ../../../src/libgpgme.la \
+@WANT_QT6_TRUE@libqgpgmeqt6_la_LIBADD = -lgpgmepp -lgpgme \
 @WANT_QT6_TRUE@                         @LIBASSUAN_LIBS@ @GPG_ERROR_LIBS@ @GPGME_QT6_LIBS@
 
-@WANT_QT6_TRUE@libqgpgmeqt6_la_LDFLAGS = -no-undefined -version-info \
+@WANT_QT6_TRUE@libqgpgmeqt6_la_LDFLAGS = -version-info \
 @WANT_QT6_TRUE@                          @LIBQGPGME_LT_CURRENT@:@LIBQGPGME_LT_REVISION@:@LIBQGPGME_LT_AGE@
 
 @HAVE_MACOS_SYSTEM_FALSE@libsuffix = .so
