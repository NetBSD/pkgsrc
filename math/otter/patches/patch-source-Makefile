$NetBSD: patch-source-Makefile,v 1.1 2026/07/26 06:14:13 rillig Exp $

Pass the CFLAGS to the compiler.

--- source/Makefile.orig	Thu Apr 13 15:34:18 2000
+++ source/Makefile
@@ -80,14 +80,14 @@
 # Specify the C compiler.  I recommend gcc (GNU C Compiler) if you have it.
 # In many Linux environments, cc is just a symlink to gcc.
 
-CC = cc
+#CC = cc
 
 #############################################################################
 #
 # Specify the compiler flags; include DFLAGS (above) -- Pick one of these
 #
 # optimized
-CFLAGS = -O $(DFLAGS)
+CFLAGS += $(DFLAGS)
 #
 # save symbols for debuggers
 # CFLAGS = -g $(DFLAGS)
