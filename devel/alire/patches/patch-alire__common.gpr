$NetBSD: patch-alire__common.gpr,v 1.4 2026/06/06 06:20:24 dkazankov Exp $

Add NetBSD support, fix switches for release build (avoiding runtime exceptions)

--- alire_common.gpr.orig	2026-05-25 15:21:25.000000000 +0300
+++ alire_common.gpr
@@ -3,6 +3,7 @@
    for Create_Missing_Dirs use "True";
 
    type Host_OSes is ("linux",
+                      "netbsd",
                       "freebsd",
                       "openbsd",
                       "macos",
@@ -108,7 +109,7 @@
                "-fPIC",
 
                --  Enable lots of extra runtime checks
-               "-gnatVa", "-gnatwa", "-gnato", "-fstack-check", "-gnata",
+               "-gnatwa", "-gnato",
                "-gnatf", "-fPIC")
               & Style_Check_Switches;
 
