$NetBSD: patch-alr.gpr,v 1.4 2026/06/06 06:20:24 dkazankov Exp $

Add NetBSD support

--- alr.gpr.orig	2026-05-25 15:21:25.000000000 +0300
+++ alr.gpr
@@ -13,6 +13,7 @@
    Src_Dirs := ("src/alr");
 
    case Alire_Common.Host_Os is
+      when "netbsd" => Src_Dirs := Src_Dirs & ("src/alr/os_linux");
       when "freebsd" => Src_Dirs := Src_Dirs & ("src/alr/os_linux");
       when "openbsd" => Src_Dirs := Src_Dirs & ("src/alr/os_linux");
       when "linux"   => Src_Dirs := Src_Dirs & ("src/alr/os_linux");
