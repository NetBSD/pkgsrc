# $NetBSD: Makefile.common,v 1.21 2026/07/24 12:15:52 adam Exp $
#
# used by devel/poco/Makefile
# used by databases/poco-data/Makefile
# used by databases/poco-data-sqlite/Makefile
# used by databases/poco-data-mysql/Makefile
# used by databases/poco-data-odbc/Makefile

POCO_VERSION=	1.15.3

DISTNAME=	poco-${POCO_VERSION}-all
MASTER_SITES=	https://pocoproject.org/releases/poco-${POCO_VERSION}/
EXTRACT_SUFX=	.tar.bz2

MAINTAINER=	pkgsrc-users@NetBSD.org
HOMEPAGE=	https://pocoproject.org/
LICENSE=	boost-license

PATCHDIR=	${.CURDIR}/../../devel/poco/patches
DISTINFO_FILE=	${.CURDIR}/../../devel/poco/distinfo

USE_CXX_FEATURES=	c++20
USE_FEATURES+=		strnlen
USE_LANGUAGES=		c c++
USE_TOOLS+=		pkg-config #gmake

CMAKE_CONFIGURE_ARGS+=	-DPOCO_MINIMAL_BUILD=ON
CMAKE_CONFIGURE_ARGS+=	-DPOCO_UNBUNDLED=ON

.include "../../mk/bsd.prefs.mk"

post-install:
.if "${PKGPATH}" == "devel/poco"
	${RM}	${DESTDIR}${PREFIX}/include/Poco/Platform.h.orig
	${RM}	${DESTDIR}${PREFIX}/include/Poco/Types.h.orig
.else
	cd ${DESTDIR}${PREFIX} && \
	${RM}	include/Poco/ordered_hash.h \
		include/Poco/ordered_map.h \
		include/Poco/ordered_set.h \
		lib/cmake/Poco/PocoConfig.cmake \
		lib/cmake/Poco/PocoConfigVersion.cmake
.endif

.include "../../converters/utf8proc/buildlink3.mk"
.include "../../devel/cmake/build.mk"
.include "../../devel/pcre2/buildlink3.mk"
