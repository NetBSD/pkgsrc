Build the man pages and the HTML docs serially
To work around both sphinx processes using the same directory
and one re-writing a file the other needs

https://github.com/linux-test-project/lcov/issues/579

--- Makefile.orig
+++ Makefile
@@ -136,5 +136,6 @@
 DOC_SOURCE := $(DOC_DIR)/conf.py $(wildcard $(DOC_DIR)/*.rst $(DOC_DIR)/man/*.rst)
 doc: $(DOC_SOURCE)
-	$(MAKE) -C docs RELEASE=${VERSION} TOOL_NAME=$(TOOL_NAME) man html
+	$(MAKE) -C docs RELEASE=${VERSION} TOOL_NAME=$(TOOL_NAME) man
+	$(MAKE) -C docs RELEASE=${VERSION} TOOL_NAME=$(TOOL_NAME) html
 	find docs/_build -type d -exec chmod u+x {} \; # apparent permissions bug??
 	touch doc
