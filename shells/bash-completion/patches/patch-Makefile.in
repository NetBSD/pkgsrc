$NetBSD: patch-Makefile.in,v 1.4 2026/07/22 07:39:53 adam Exp $

Don't install profile.d bits.

--- Makefile.in.orig	2026-07-05 08:06:57.000000000 +0000
+++ Makefile.in
@@ -333,7 +333,6 @@ pkgdata_DATA = bash_completion
 compatdir = $(sysconfdir)/bash_completion.d
 compat_DATA = 
 profiledir = $(sysconfdir)/profile.d
-profile_DATA = bash_completion.sh
 pkgconfigdir = $(datadir)/pkgconfig
 pkgconfig_DATA = bash-completion.pc
 cmakeconfigdir = $(datadir)/cmake/$(PACKAGE)/
