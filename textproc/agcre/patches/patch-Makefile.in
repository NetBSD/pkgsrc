$NetBSD: patch-Makefile.in,v 1.1 2026/10/14 04:05:11 agc Exp $

Make sure we link the library we're depending on

don't install library manual pages in the binary package

--- Makefile.in	2026/10/14 03:46:16	1.1
+++ Makefile.in	2026/10/14 03:46:30
@@ -2,7 +2,7 @@
 
 PROG=	agcre
 
-OBJS=	agcre.o main.o
+OBJS=	main.o
 
 PREFIX=@PREFIX@
 MANDIR=@MANDIR@
@@ -14,7 +14,7 @@
 COPT?=	-g -O0
 
 ${PROG}: ${OBJS}
-	${CC} ${COPT} ${OBJS} -o ${PROG}
+	${CC} ${COPT} ${OBJS} -L${PREFIX}/lib -Wl,-R${PREFIX}/lib -l agcre -o ${PROG}
 
 .c.o:
 	${CC} ${COPT} -c $<
@@ -22,8 +22,6 @@
 install:
 	install -c -s ${PROG} ${DESTDIR}${PREFIX}/bin
 	install -c agcre.1 ${DESTDIR}${MANDIR}/man1
-	install -c libagcre.3 ${DESTDIR}${MANDIR}/man3
-	install -c agcre_format.7 ${DESTDIR}${MANDIR}/man7
 
 clean cleandir:
 	rm -f *.o *.core ${PROG}
