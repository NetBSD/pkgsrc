Add NetBSD support

--- Makefile.orig	2024-08-23 18:53:29.000000000 +0300
+++ Makefile
@@ -101,12 +101,16 @@
 ifeq ($(strip $(findstring freebsd, $(TARGET))),freebsd)
    PRJ_TARGET=FreeBSD
 else
+ifeq ($(strip $(findstring netbsd, $(TARGET))),netbsd)
+   PRJ_TARGET=FreeBSD
+else
    PRJ_TARGET=UNIX
 endif
 endif
 endif
 endif
 endif
+endif
 
 -include makefile.setup
 
