$NetBSD: patch-Makefile.in,v 1.2 2025/07/23 17:03:29 prlw1 Exp $

Add destdir support.

--- Makefile.in.orig	2022-10-16 11:09:29.000000000 +0000
+++ Makefile.in
@@ -14,7 +14,7 @@ INSTALL = @INSTALL@
 INSTALL_DATA = @INSTALL_DATA@
 
 BINDIR=@prefix@/bin
-MANDIR=@prefix@/man
+MANDIR=@mandir@
 
 # BINDIR is the directory in which the command is installed.
 # MANDIR is the directory in which the man pages are installed.
@@ -49,9 +49,9 @@ test:           build
 check:          test
 
 install:        build
-		$(mkinstalldirs) $(BINDIR)
-		$(mkinstalldirs) $(MANDIR)
-		$(mkinstalldirs) $(MANDIR)/man1
-		$(INSTALL) src/aspic $(BINDIR)/aspic
-		$(INSTALL_DATA) doc/aspic.1 $(MANDIR)/man1
+		$(mkinstalldirs) $(DESTDIR)$(BINDIR)
+		$(mkinstalldirs) $(DESTDIR)$(MANDIR)
+		$(mkinstalldirs) $(DESTDIR)$(MANDIR)/man1
+		$(INSTALL) src/aspic $(DESTDIR)$(BINDIR)/aspic
+		$(INSTALL_DATA) doc/aspic.1 $(DESTDIR)$(MANDIR)/man1
 # End
