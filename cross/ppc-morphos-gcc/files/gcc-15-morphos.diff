+/* __gthr_morphos_mutex_lock */
+int __gthr_morphos_mutex_lock (__gthread_mutex_t *_gthr_mutex)
+{
+	return __gthr_morphos_mutex_lock_generic (_gthr_mutex, 0);
+}
