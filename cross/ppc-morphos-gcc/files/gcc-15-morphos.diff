+/* We can't use 'bl' from .init/.fini to .text, so use a trampoline. */
+#define CRT_CALL_STATIC_FUNCTION(SECTION_OP, FUNC) \
+static void __attribute__((__used__))              \
+call_ ## FUNC (void) {                             \
+  asm(SECTION_OP "\n"                              \
+      "lis 11," #FUNC "@ha\n"                      \
+      "addi 11,11," #FUNC "@l\n"                   \
+      "mtctr 11\n"                                 \
+      "bctrl\n"                                    \
+      TEXT_SECTION_ASM_OP); }
