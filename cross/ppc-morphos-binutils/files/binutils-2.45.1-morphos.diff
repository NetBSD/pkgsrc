+OUTPUT_ARCH(${OUTPUT_ARCH})
+
+${RELOCATING+ENTRY (__start)}
+${RELOCATING+${LIB_SEARCH_DIRS}}
+${RELOCATING+${EXECUTABLE_SYMBOLS}}
+${RELOCATING+${INPUT_FILES}}
+${RELOCATING- /* For some reason, the Solaris linker makes bad executables
