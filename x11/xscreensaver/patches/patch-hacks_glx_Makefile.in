$NetBSD: patch-hacks_glx_Makefile.in,v 1.1 2026/01/16 23:12:45 hauke Exp $

Do not add the generated bash scripts to the executables list -
stripping them will fail, and they will get deleted.

--- hacks/glx/Makefile.in.orig	2026-01-16 23:02:07.793808971 +0000
+++ hacks/glx/Makefile.in
@@ -163,7 +163,7 @@ GLSL_SRCS	= glsl/alienbeacon.glsl glsl/b
 		  glsl/stripeytorus.glsl glsl/synthwavecity.glsl \
 		  glsl/topologica.glsl glsl/truchetzoom.glsl
 
-SCRIPTS		= mapscroller.pl
+SCRIPTS		= mapscroller.pl $(GLSL_EXES)
 
 OBJS		= xscreensaver-gl-visual.o normals.o erase-gl.o fps-gl.o \
 		  atlantis.o b_draw.o b_lockglue.o b_sphere.o bubble3d.o \
@@ -254,7 +254,7 @@ SUID_EXES	= sonar
 SETCAP_EXES	= sonar
 GL_UTIL_EXES	= xscreensaver-gl-visual
 JWZGLES_OBJS	= @JWZGLES_OBJS@
-HACK_EXES_1	= @GL_EXES@ @GLE_EXES@ $(GLSL_EXES)
+HACK_EXES_1	= @GL_EXES@ @GLE_EXES@ ## $(GLSL_EXES)
 HACK_EXES	= $(HACK_EXES_1) @SUID_EXES@
 XSHM_OBJS	= $(UTILS_BIN)/xshm.o $(UTILS_BIN)/aligned_malloc.o
 DT		= $(UTILS_BIN)/doubletime.o
