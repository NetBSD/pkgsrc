$NetBSD: patch-make.local,v 1.2 2025/10/12 08:24:30 vins Exp $

Local makefile for pkgsrc.

--- make.local.orig	2025-10-12 08:18:05.837454640 +0000
+++ make.local
@@ -0,0 +1,14 @@
+# pkgsrc Makefile
+
+SRCS	= xfind.c util.c
+PROG	= xfind
+
+CLEANFILES	+= xfind.1
+
+LDADD	+= -lc -lm -lXm -lXt -lX11
+DPADD	+= ${LIBC} ${LIBM} ${LIBXM} ${LIBXT} ${LIBX11}
+
+xfind.1: ${.CURDIR}/$(PROG).man
+	@cp ${.ALLSRC} ${.TARGET}
+
+.include <bsd.prog.mk>
