$NetBSD: patch-Make.pkgsrc,v 1.2 2025/11/30 10:31:25 vins Exp $

Standard configuration for pkgsrc.

--- Make.pkgsrc.orig	2025-11-30 11:25:30.576799613 +0000
+++ Make.pkgsrc
@@ -0,0 +1,11 @@
+# pkgsrc
+CFLAGS	+= -Wall -Wno-missing-braces -Wno-parentheses \
+	-I$(ROOT) -I$(ROOT)/include -I$(ROOT)/kern \
+	-c -I$(X11)/include -D_THREAD_SAFE $(PTHREAD)
+O	= o
+OS	= posix
+GUI	= x11
+TARG	= drawterm
+AUDIO	?= none
+
+all: default
