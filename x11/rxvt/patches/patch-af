+	sys/stropts.h \
 	sys/strredir.h \
 	sys/time.h \
 	utmp.h \
@@ -12964,6 +12966,7 @@ for ac_func in \
 	on_exit \
 	nanosleep \
 	updwtmp \
+	updwtmpx \
 	ttyslot \
 
