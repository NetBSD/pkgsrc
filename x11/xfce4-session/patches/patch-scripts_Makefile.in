Adjust config path.

--- scripts/Makefile.in.orig	2025-03-24 03:24:43.000000000 +0000
+++ scripts/Makefile.in
@@ -389,7 +389,7 @@ edit = $(SED) \
 	-e "s,@_datadir_\@,$(datadir),g" \
 	-e "s,@_sysconfdir_\@,$(sysconfdir),g"
 
-conffilesdir = @sysconfdir@/xdg/xfce4
+conffilesdir = $(datadir)/examples/xfce4
 conffiles_DATA = \
 	xinitrc \
 	Xft.xrdb
