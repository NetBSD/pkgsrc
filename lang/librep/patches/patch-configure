Modernize C tests to fix builds with GCC >= 14.
https://github.com/SawfishWM/librep/commit/48f557ab34d47a7a1fd9e8425542f720be40946e

Account for loongarch64 and riscv stack direction.
https://github.com/SawfishWM/librep/commit/e668e25fd994a76275d788e16f290931372773b5
https://github.com/SawfishWM/librep/commit/52d64573cf4e3e6d92ef7ec2b72a73abdccd0389

--- configure.orig	2017-08-25 20:05:31.000000000 +0000
+++ configure
@@ -14798,7 +14798,8 @@ else
 else
   cat confdefs.h - <<_ACEOF >conftest.$ac_ext
 /* end confdefs.h.  */
-main () { exit (!(sizeof (int) >= sizeof (void *)));}
+#include <stdlib.h>
+int main () { exit (!(sizeof (int) >= sizeof (void *)));}
 _ACEOF
 if ac_fn_c_try_run "$LINENO"; then :
   with_value_type=int
@@ -14817,7 +14818,8 @@ else
 else
   cat confdefs.h - <<_ACEOF >conftest.$ac_ext
 /* end confdefs.h.  */
-main () { exit (!(sizeof (long int) >= sizeof (void *)));}
+#include <stdlib.h>
+int main () { exit (!(sizeof (long int) >= sizeof (void *)));}
 _ACEOF
 if ac_fn_c_try_run "$LINENO"; then :
   with_value_type="long int"
@@ -14836,7 +14838,8 @@ else
 else
   cat confdefs.h - <<_ACEOF >conftest.$ac_ext
 /* end confdefs.h.  */
-main () { exit (!(sizeof (long long int) >= sizeof (void *)));}
+#include <stdlib.h>
+int main () { exit (!(sizeof (long long int) >= sizeof (void *)));}
 _ACEOF
 if ac_fn_c_try_run "$LINENO"; then :
   with_value_type="long long int"
@@ -14877,7 +14880,8 @@ else
   cat confdefs.h - <<_ACEOF >conftest.$ac_ext
 /* end confdefs.h.  */
 #include <stdio.h>
-	      main () {
+#include <stdlib.h>
+int main () {
 		FILE *f = fopen ("conftestval", "w");
 		if (!f) exit (1);
 		fprintf (f, "%d\n", sizeof (${with_value_type}));
@@ -15101,7 +15105,7 @@ if test "${with_stack_direction}" = unknown; then
 
 if test "${with_stack_direction}" = unknown; then
   case ${host_cpu} in
