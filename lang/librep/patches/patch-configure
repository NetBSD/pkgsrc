+    sparc*|i?86*|powerpc*|x86_64*|arm*|aarch64*|s390*|mips*|alpha*|ia64*|loongarch64*|riscv*)
       { $as_echo "$as_me:${as_lineno-$LINENO}: result: assuming downwards" >&5
 $as_echo "assuming downwards" >&6; }
       with_stack_direction="-1"
@@ -15122,6 +15126,7 @@ else
 else
   cat confdefs.h - <<_ACEOF >conftest.$ac_ext
 /* end confdefs.h.  */
