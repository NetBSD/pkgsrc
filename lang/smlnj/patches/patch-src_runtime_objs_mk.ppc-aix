$NetBSD: patch-src_runtime_objs_mk.ppc-aix,v 1.2 2026/07/21 14:03:28 ryoon Exp $

Honor pkgsrc CFLAGS.

--- src/runtime/objs/mk.ppc-aix.orig	2026-07-21 09:51:27.690325802 +0000
+++ src/runtime/objs/mk.ppc-aix
@@ -5,7 +5,7 @@ CC =            cc
 
 # note: the vendor cpp isn't expanding nested macro applications correctly.
 CC =            cc
-CFLAGS =        -O2
+CFLAGS =        @CFLAGS@
 CPP =           /lib/cpp
 
 #CC =            gcc -ansi
@@ -14,6 +14,7 @@ XLIBS =
 
 XOBJS =
 XLIBS =
+LDFLAGS =	@LDFLAGS@
 LD_LIBS =	-lm
 BASE_DEFS =
 DEFS =		$(BASE_DEFS) -DARCH_PPC -DDSIZE_32 -DOPSYS_UNIX -DOPSYS_AIX -DUNBOXEDFLOAT=1
@@ -22,4 +23,4 @@ all:
 RUNTIME =	run.ppc-aix
 
 all:
-	(make RUNTIME="$(RUNTIME)" VERSION="$(VERSION)" CC="$(CC)" CPP="$(CPP)" CFLAGS="$(CFLAGS)" AS="$(AS)" TARGET=$(TARGET) DEFS="$(DEFS)" XOBJS="$(XOBJS)" XLIBS="$(XLIBS)" LD_LIBS="$(LD_LIBS)" $(RUNTIME))
+	(make RUNTIME="$(RUNTIME)" VERSION="$(VERSION)" CC="$(CC)" CPP="$(CPP)" CFLAGS="$(CFLAGS)" AS="$(AS)" TARGET=$(TARGET) DEFS="$(DEFS)" XOBJS="$(XOBJS)" XLIBS="$(XLIBS)" LD_LIBS="$(LD_LIBS)" LDFLAGS="$(LDFLAGS)" $(RUNTIME))
