$NetBSD: patch-src_runtime_objs_mk.x86-cygwin,v 1.3 2026/07/21 14:03:28 ryoon Exp $

Honor pkgsrc CFLAGS.

--- src/runtime/objs/mk.x86-cygwin.orig	2026-07-21 09:51:27.690510688 +0000
+++ src/runtime/objs/mk.x86-cygwin
@@ -5,10 +5,11 @@ CC =		gcc -std=gnu99
 
 MAKE =		make
 CC =		gcc -std=gnu99
-CFLAGS =	-O2
+CFLAGS =	@CFLAGS@
 CPP =		gcc -x assembler-with-cpp -E -P
 XOBJS =
 XLIBS =		../c-libs/dl/libunix-dynload.a
+LDFLAGS =	@LDFLAGS@
 LD_LIBS =	-lm
 XDEFS =
 BASE_DEFS =
@@ -19,4 +20,4 @@ all:
 RUNTIME =	run.x86-cygwin
 
 all:
-	($(MAKE) RUNTIME="$(RUNTIME)" VERSION="$(VERSION)" CC="$(CC)" CFLAGS="$(CFLAGS)" CPP="$(CPP)" TARGET=$(TARGET) DEFS="$(DEFS)" XOBJS="$(XOBJS)" XLIBS="$(XLIBS)" LD_LIBS="$(LD_LIBS)" $(RUNTIME))
+	($(MAKE) RUNTIME="$(RUNTIME)" VERSION="$(VERSION)" CC="$(CC)" CFLAGS="$(CFLAGS)" CPP="$(CPP)" TARGET=$(TARGET) DEFS="$(DEFS)" XOBJS="$(XOBJS)" XLIBS="$(XLIBS)" LD_LIBS="$(LD_LIBS)" LDFLAGS="$(LDFLAGS)" $(RUNTIME))
