$NetBSD: patch-libguile_Makefile.in,v 1.3 2025/03/30 07:49:12 wiz Exp $

Fix date arguments.
https://debbugs.gnu.org/cgi/bugreport.cgi?bug=26121

--- libguile/Makefile.in.orig	2024-06-23 21:38:47.000000000 +0000
+++ libguile/Makefile.in
@@ -4606,7 +4606,7 @@ uninstall-hook:
 @MINGW_LIBPATH_TRUE@	@echo '	{ "LIBS",	   "@GUILE_LIBS@" }, \' >> libpath.tmp
 @MINGW_LIBPATH_TRUE@	@echo '	{ "CFLAGS",	   "@GUILE_CFLAGS@" }, \' >> libpath.tmp
 @MINGW_LIBPATH_TRUE@	@BUILD_DATE="$${SOURCE_DATE_EPOCH:-`date '+%s'`}" ; \
-@MINGW_LIBPATH_TRUE@	 echo '	{ "buildstamp",    "'`date -u +'%Y-%m-%d %T' -d @$$BUILD_DATE`'" }, \' >> libpath.tmp
+@MINGW_LIBPATH_TRUE@	 echo '	{ "buildstamp",    "'`date -u -d @$$BUILD_DATE +'%Y-%m-%d %T'`'" }, \' >> libpath.tmp
 @MINGW_LIBPATH_TRUE@	@echo '}' >> libpath.tmp
 @MINGW_LIBPATH_TRUE@	$(AM_V_GEN)mv libpath.tmp libpath.h
 @MINGW_LIBPATH_FALSE@libpath.h: $(srcdir)/Makefile.in  $(top_builddir)/config.status
@@ -4648,7 +4648,7 @@ uninstall-hook:
 @MINGW_LIBPATH_FALSE@	@echo '	{ "LIBS",	   "@GUILE_LIBS@" }, \' >> libpath.tmp
 @MINGW_LIBPATH_FALSE@	@echo '	{ "CFLAGS",	   "@GUILE_CFLAGS@" }, \' >> libpath.tmp
 @MINGW_LIBPATH_FALSE@	@BUILD_DATE="$${SOURCE_DATE_EPOCH:-`date '+%s'`}" ; \
-@MINGW_LIBPATH_FALSE@	 echo '	{ "buildstamp",    "'`date -u +'%Y-%m-%d %T' -d @$$BUILD_DATE`'" }, \' >> libpath.tmp
+@MINGW_LIBPATH_FALSE@	 echo '	{ "buildstamp",    "'`date -u -d @$$BUILD_DATE +'%Y-%m-%d %T'`'" }, \' >> libpath.tmp
 @MINGW_LIBPATH_FALSE@	@echo '}' >> libpath.tmp
 @MINGW_LIBPATH_FALSE@	$(AM_V_GEN)mv libpath.tmp libpath.h
 
