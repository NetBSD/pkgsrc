$NetBSD: patch-src_cs_c_configure,v 1.4 2025/12/29 01:55:27 ktnb Exp $

Allow CONFIGURE_ENV to set PAXCTL so user need not have /usr/sbin in
PATH.

--- src/cs/c/configure.orig	2025-10-20 23:35:48.000000000 +0000
+++ src/cs/c/configure
@@ -3129,7 +3129,7 @@ if test "$enable_pkgs" != ""  ; then
   show_pkg_catalog="yes"
 fi
 
-if test "$enable_missingpkgs" == "yes"  ; then
+if test "$enable_missingpkgs" = "yes"  ; then
   echo "=== Adding any missing package dependencies on install"
   show_pkg_catalog="yes"
 fi
@@ -4606,7 +4606,7 @@ case "$host_os" in
     LINK_DYNAMIC="-rdynamic"
     skip_iconv_check=yes
     add_curses_lib="-lterminfo"
-    default_post_linker="paxctl +m"
+    default_post_linker="${PAXCTL:-paxctl} +m"
     ;;
   irix*)
     ;;
