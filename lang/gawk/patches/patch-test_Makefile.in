$NetBSD: patch-test_Makefile.in,v 1.7 2026/09/24 13:23:17 wiz Exp $

pkgsrc replacement links mean -L should be used too.

NB on SunOS, locale/en should be installed in order to have
all tests successfully execute (namely mbfw1 and mbprintf1)

--- test/Makefile.in.orig	2026-07-09 16:48:35.000000000 +0000
+++ test/Makefile.in
@@ -3038,7 +3038,7 @@ readdir:
 	echo If it does, try rerunning on an ext'[234]' filesystem. ; \
 	fi
 	@-$(AWK) -f "$(srcdir)"/readdir.awk "$(top_srcdir)" | sort -n > _$@ || echo EXIT CODE: $$? >> _$@
-	@-ls -afi "$(top_srcdir)" > _dirlist
+	@-ls -afiL "$(top_srcdir)" > _dirlist
 	@-ls -lna "$(top_srcdir)" | sed 1d > _longlist
 	@-$(AWK) -f "$(srcdir)"/readdir0.awk -v extout=_$@  \
 		-v dirlist=_dirlist -v longlist=_longlist | sort -n  > $@.ok
