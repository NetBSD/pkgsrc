$NetBSD: patch-Makefile.bsd,v 1.2 2026/09/10 21:41:55 mef Exp $

Honer pkgsrc LDFLAGS

--- Makefile.bsd.orig	2024-07-16 14:43:18.000000000 +0900
+++ Makefile.bsd	2026-09-10 21:13:58.552845861 +0900
@@ -65,6 +65,7 @@ include $(SRCDIR)/defaults.make
 #
 #C_COMPILER_OPTIONS += -I/usr/pkg/lib
 #LINKER_OPTIONS += -L/usr/pkg/lib -Wl,-R/usr/pkg/lib
+LINKER_OPTIONS += @LDFLAGS@
 
 chicken-config.h: chicken-defaults.h
 	echo "/* GENERATED */" >$@
