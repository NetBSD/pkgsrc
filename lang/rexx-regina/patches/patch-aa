-         LD_RXLIB_UTILA="ld -Bdynamic -Bshareable ${LDFLAGS} -o \$(@)"
-         LD_RXLIB_B1="-lc -L. -l${SHLFILE}"
-         LD_RXLIB_B2="-lc -L. -l${SHLFILE}"
-         LD_RXLIB_UTILB="-lc -L. -l${SHLFILE}"
