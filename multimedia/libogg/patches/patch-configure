$NetBSD: patch-configure,v 1.3 2025/06/30 19:18:38 adam Exp $

Do not force compiler optimization flags.

--- configure.orig	2025-06-16 16:02:25.000000000 +0000
+++ configure
@@ -13658,17 +13658,17 @@ if test -z "$GCC"; then
         case $host in
         *-*-irix*)
                 DEBUG="-g -signed"
-                CFLAGS="-O2 -w -signed"
+                CFLAGS="-w -signed"
                 PROFILE="-p -g3 -O2 -signed"
 		;;
         sparc-sun-solaris*)
                 DEBUG="-v -g"
-                CFLAGS="-xO4 -fast -w -fsimple -native -xcg92"
+                CFLAGS="-fast -w -fsimple -native -xcg92"
                 PROFILE="-v -xpg -g -xO4 -fast -native -fsimple -xcg92 -Dsuncc"
 		;;
         *)
                 DEBUG="-g"
-                CFLAGS="-O"
+                CFLAGS=""
                 PROFILE="-g -p"
 		;;
         esac
@@ -13676,22 +13676,22 @@ else
         case $host in
         *-*-linux*)
                 DEBUG="-g -Wall -Wextra -fsigned-char"
-                CFLAGS="-O2 -Wall -Wextra -ffast-math -fsigned-char"
+                CFLAGS="-Wall -Wextra -ffast-math -fsigned-char"
                 PROFILE="-Wall -Wextra -W -pg -g -O2 -ffast-math -fsigned-char"
 		;;
         sparc-sun-*)
                 DEBUG="-g -Wall -Wextra -fsigned-char"
-                CFLAGS="-O2 -ffast-math -fsigned-char"
+                CFLAGS="-ffast-math -fsigned-char"
                 PROFILE="-pg -g -O2 -fsigned-char"
 		;;
 	*-*-darwin*)
 		DEBUG="-fno-common -g -Wall -Wextra -fsigned-char"
-		CFLAGS="-fno-common -O4 -Wall -Wextra -fsigned-char -ffast-math"
+		CFLAGS="-fno-common -Wall -Wextra -fsigned-char -ffast-math"
 		PROFILE="-fno-common -O4 -Wall -Wextra -pg -g -fsigned-char -ffast-math"
 		;;
         *)
                 DEBUG="-g -Wall -Wextra -fsigned-char"
-                CFLAGS="-O2 -fsigned-char"
+                CFLAGS="-fsigned-char"
                 PROFILE="-O2 -g -pg -fsigned-char"
 		;;
         esac
