$NetBSD: patch-src_xpdev_Common.gmake,v 1.3 2025/10/12 06:01:33 vins Exp $

Allow discovery of PortAudio within pkgsrc prefix. 

--- src/xpdev/Common.gmake.orig	2025-10-12 05:48:59.765729609 +0000
+++ src/xpdev/Common.gmake
@@ -204,7 +204,7 @@ else
 endif
 
 ifndef WITHOUT_PORTAUDIO
- PORTAUDIO_PATH ?=      $(shell if [ -f /usr/local/include/portaudio.h ]; then echo /usr/local ; elif [ -f /usr/include/portaudio.h ] ; then echo /usr ; else echo NOTFOUND ; fi)
+ PORTAUDIO_PATH ?=      $(shell if [ -f $(PREFIX)/include/portaudio.h ]; then echo $(PREFIX); elif [ -f /usr/local/include/portaudio.h ]; then echo /usr/local ; elif [ -f /usr/include/portaudio.h ] ; then echo /usr ; else echo NOTFOUND ; fi)
  ifndef win
   ifneq ($(PORTAUDIO_PATH),NOTFOUND)
    XPDEV_CFLAGS += -DWITH_PORTAUDIO
