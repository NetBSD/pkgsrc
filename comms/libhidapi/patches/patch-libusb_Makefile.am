$NetBSD: patch-libusb_Makefile.am,v 1.3 2026/11/16 16:48:44 adam Exp $

Support NetBSD.

--- libusb/Makefile.am.orig	2026-11-15 21:12:48.000000000 +0000
+++ libusb/Makefile.am
@@ -14,6 +14,13 @@ libhidapi_libusb_la_LDFLAGS = $(LTLDFLAG
 libhidapi_libusb_la_LIBADD = $(LIBS_LIBUSB)
 endif
 
+if OS_NETBSD
+lib_LTLIBRARIES = libhidapi.la
+libhidapi_la_SOURCES = hid.c
+libhidapi_la_LDFLAGS = $(LTLDFLAGS)
+libhidapi_la_LIBADD = $(LIBS_LIBUSB)
+endif
+
 if OS_KFREEBSD
 lib_LTLIBRARIES = libhidapi.la
 libhidapi_la_SOURCES = hid.c
