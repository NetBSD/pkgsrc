$NetBSD: patch-src_common.mf,v 1.4 2025/08/03 07:33:35 vins Exp $

* Use standard CFLAGS and LDFLAGS.
* Provide a pkgsrc-compliant install target.

--- src/common.mf.orig	2025-08-02 14:30:15.000000000 +0000
+++ src/common.mf
@@ -16,10 +16,10 @@ mwm_objs = \
 	WmXinerama.o WmEwmh.o
 
 emwm: $(mwm_objs)
-	$(CC) $(LDFLAGS) $(LIBDIRS) -o $@ $(mwm_objs) $(SYSLIBS)
+	$(CC) $(LDFLAGS) -o $@ $(mwm_objs) $(SYSLIBS)
 
 .depend:
-	$(CC) -MM $(INCDIRS) $(mwm_objs:.o=.c) $(wsm_objs:.o=.c) > $@
+	$(CC) -MM $(CFLAGS) $(mwm_objs:.o=.c) $(wsm_objs:.o=.c) > $@
 
 .PHONY: clean install common_install
 
@@ -28,15 +28,14 @@ clean:
 	-rm .depend
 
 common_install:
-	install -m 755 emwm $(PREFIX)/bin/emwm
-	install -m 755 -d $(MANDIR)/man1
-	install -m 644 emwm.1 $(MANDIR)/man1/emwm.1
-	install -m 755 -d $(MANDIR)/man4
-	install -m 644 emwmrc.4 $(MANDIR)/man4/emwmrc.4
-	install -m 755 -d $(RCDIR)
-	install -m 644 system.emwmrc $(RCDIR)/system.emwmrc
-	install -m 755 -d $(APPLRESDIR)
-	install -m 644 Emwm.ad $(APPLRESDIR)/Emwm
+	$(BSD_INSTALL_PROGRAM_DIR) $(DESTDIR)$(BINDIR)
+	$(BSD_INSTALL_PROGRAM) emwm $(DESTDIR)$(BINDIR)
+	$(BSD_INSTALL_MAN_DIR) $(DESTDIR)$(MANDIR)/man1 $(DESTDIR)$(MANDIR)/man4
+	$(BSD_INSTALL_MAN) emwm.1 $(DESTDIR)$(MANDIR)/man1
+	$(BSD_INSTALL_MAN) emwmrc.4 $(DESTDIR)$(MANDIR)/man4
+	$(BSD_INSTALL_DATA_DIR) $(DESTDIR)$(RCDIR) $(DESTDIR)$(APPLRESDIR)
+	$(BSD_INSTALL_DATA) system.emwmrc $(DESTDIR)$(RCDIR)/system.emwmrc
+	$(BSD_INSTALL_DATA) Emwm.ad $(DESTDIR)$(APPLRESDIR)/Emwm
 
 uninstall:
 	rm -f $(PREFIX)/bin/emwm
